{
  "name": "shiru",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp check --no-fmt --no-lint",
    "deploy:dry-run": "vp run -r deploy:dry-run",
    "hooks:setup": "vp config",
    "dev:dashboard": "vp run --filter dashboard dev",
    "dev:api": "vp run --filter api dev",
    "db:generate": "vp run --filter api db:generate",
    "db:migrate": "vp run --filter api db:migrate",
    "db:push": "vp run --filter api db:push",
    "update": "vp update --recursive --workspace-root --interactive --latest",
    "test": "vp run --filter api --filter dispatch --filter dashboard test",
    "deploy": "vp run db:migrate && vp run -r deploy"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.9.1"
}
