# Browsers revalidate pages on every visit and get the answer from the edge cache, which keeps it until the next deploy empties it.
# Files under /_astro/ have content hashes in their names, so browsers keep them forever.
/*
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=31536000
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
