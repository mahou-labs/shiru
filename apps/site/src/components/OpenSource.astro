---
import type { Section } from "../content";
import Icon from "./Icon.astro";
import Rich from "./Rich.astro";
import Title from "./Title.astro";

type Props = Extract<Section, { kind: "openSource" }>;

const { id, heading, blocks } = Astro.props;
---

<section {id} class="my-8 scroll-mt-20 bg-tint py-24 md:my-12 md:py-32">
  <div class="mx-auto grid w-full max-w-[1200px] gap-12 px-5 md:px-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <h2 class="max-w-[14ch] text-[2.25rem]/[1.05] font-medium tracking-[-0.03em] md:text-[3.25rem]">
      <span class="mr-3 align-[0.15em] font-mono text-[0.5em] font-normal text-fg-faint" aria-hidden="true">##</span><Title text={heading} />
    </h2>
    <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
      {
        blocks.map((block) => (
          <div class="flex flex-col gap-2 border-t border-border-strong pt-6">
            <h3 class="text-[1.0625rem]/7 font-medium tracking-[-0.01em]">{block.title}</h3>
            <p class="text-[0.9375rem]/[1.55] text-fg-muted">
              <Rich text={block.body} />
            </p>
            {block.link && (
              <a
                href={block.link.href}
                class="group/link mt-2 inline-flex items-center gap-1.5 self-start rounded-md text-[0.9375rem] font-medium text-fg transition-colors duration-200 ease-out hover:text-fg-muted pointer-coarse:min-h-11"
              >
                {block.link.label}
                <Icon
                  name="arrow"
                  class="size-4 transition-transform duration-150 ease-out group-hover/link:translate-x-0.5"
                />
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
