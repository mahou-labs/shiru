---
import { page } from "../content";
import Logo from "./Logo.astro";

const links = [
  { label: "GitHub", href: page.links.github },
  { label: `X (${page.links.x.handle})`, href: page.links.x.href },
  { label: "llms.txt", href: "/llms.txt", code: true },
  { label: "index.md", href: "/index.md", code: true },
];
---

<footer class="border-t border-border">
  <div class="mx-auto grid w-full max-w-[1200px] gap-10 px-5 py-14 md:grid-cols-[1fr_auto] md:px-10">
    <div>
      <a href="/" class="-ml-1 inline-flex items-center gap-2.5 rounded-lg px-1 py-1 text-[0.9375rem] font-semibold tracking-tight">
        <span class="grid size-7 place-items-center rounded-lg bg-accent"><Logo class="size-5 text-on-accent" /></span>
        <span translate="no">{page.name}</span>
      </a>
      <p class="mt-3 text-[0.9375rem] text-fg-muted">{page.footer.tagline}</p>
    </div>
    <ul class="flex flex-col gap-1 md:items-end">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-8 items-center rounded-md text-[0.9375rem] text-fg-muted transition-colors duration-200 ease-out hover:text-fg pointer-coarse:min-h-11"
              translate={link.code ? "no" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-[0.8125rem] text-fg-muted md:col-span-2">{page.footer.copyright}</p>
  </div>
</footer>
