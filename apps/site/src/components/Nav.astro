---
import { page } from "../content";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const link =
  "rounded-lg px-3 py-2 text-[0.9375rem] font-medium text-fg-muted transition-colors duration-200 ease-out hover:text-fg";
---

<header
  class="sticky top-0 z-40 border-b border-transparent pt-[env(safe-area-inset-top)] transition-[background-color,border-color] duration-300 ease-out data-scrolled:border-border data-scrolled:bg-bg/85 data-scrolled:backdrop-blur-md data-scrolled:backdrop-saturate-150 supports-[not(backdrop-filter:blur(1px))]:data-scrolled:bg-bg"
  data-nav
>
  <nav
    class="mx-auto grid h-16 w-full max-w-[1200px] grid-cols-[1fr_auto] items-center gap-4 px-5 md:h-20 md:grid-cols-[auto_1fr_auto] md:gap-9 md:px-10"
    aria-label="Main"
  >
    <a href="/" class="-ml-1 flex items-center justify-self-start gap-2.5 rounded-lg px-1 py-1 text-[0.9375rem] font-semibold tracking-tight">
      <span class="grid size-7 place-items-center rounded-lg bg-accent text-on-accent"><Logo class="size-5 text-on-accent" /></span>
      <span translate="no">{page.name}</span>
    </a>

    <ul class="hidden items-center gap-0.5 md:flex">
      {
        page.nav.map((item) => (
          <li>
            <a class={link} href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1 justify-self-end">
      <a class:list={[link, "hidden md:inline-block"]} href={page.links.github}>GitHub</a>
      <a
        href="#waitlist"
        class="ml-1 inline-flex h-8 items-center rounded-[10px] bg-accent px-3.5 text-[0.9375rem] font-medium tracking-tight text-on-accent transition-[transform,background-color] duration-150 ease-out hover:bg-accent-hover active:scale-[0.97] pointer-coarse:h-11"
      >
        Join waitlist
      </a>
      <details class="group relative md:hidden">
        <summary
          class="grid size-11 list-none place-items-center rounded-[10px] text-fg transition-colors duration-150 hover:bg-fg/5 group-open:bg-fg/5 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" />
        </summary>
        <ul
          class="absolute top-full right-0 mt-2 w-56 rounded-2xl bg-surface p-1.5 shadow-window"
        >
          {
            [...page.nav, { label: "GitHub", href: page.links.github }].map((item) => (
              <li>
                <a
                  class="flex h-11 items-center rounded-xl px-3 font-medium text-fg hover:bg-fg/5"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const update = () => nav.toggleAttribute("data-scrolled", window.scrollY > 8);
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>
