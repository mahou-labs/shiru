---
import { highlight, type Lang, type Token, type TokenKind } from "../highlight";

interface Props {
  code: string;
  lang: Lang;
  numbers?: boolean;
  mark?: number[];
  // Replaces `remove` lines starting at `line` with `add`. The rendered default is the applied
  // change; under motion-safe the removed lines play first and collapse.
  diff?: { line: number; remove: number; add: string };
  label: string;
  wrap?: boolean;
  class?: string;
}

const { code, lang, numbers = false, mark = [], diff, label, wrap = false, class: className } = Astro.props;
const lines = highlight(code, lang);
const color: Record<TokenKind, string> = {
  keyword: "text-mock-keyword",
  string: "text-mock-string",
  comment: "text-mock-comment",
  accent: "text-mock-accent",
};

type Row = { tokens: Token[]; gutter: string; marked?: boolean };
type Segment = { rows: Row[]; class: string; style?: string; hidden?: true };

const rows = (from: number, to: number): Row[] =>
  lines.slice(from, to).map((tokens, i) => ({
    tokens,
    gutter: String(from + i + 1),
    marked: mark.includes(from + i + 1),
  }));

const plain = (rows: Row[]): Segment => ({ rows, class: "contents" });

const segments: Segment[] = diff
  ? [
      plain(rows(0, diff.line - 1)),
      {
        rows: rows(diff.line - 1, diff.line - 1 + diff.remove),
        class:
          "block h-0 overflow-hidden line-through decoration-transparent opacity-0 motion-safe:animate-diff-del",
        style: `--rows: ${diff.remove}`,
        hidden: true,
      },
      {
        rows: highlight(diff.add, lang).map((tokens) => ({ tokens, gutter: "+" })),
        class: "block overflow-hidden bg-mock-string/10 motion-safe:animate-diff-add",
        style: `--rows: ${diff.add.split("\n").length}; height: ${diff.add.split("\n").length}lh`,
      },
      plain(rows(diff.line - 1 + diff.remove, lines.length)),
    ]
  : [plain(rows(0, lines.length))];

// The reserved height is the applied change, so the window never resizes while it plays.
const height = diff && segments.filter((s) => !s.hidden).reduce((n, s) => n + s.rows.length, 0);
---

<pre
  class:list={[
    wrap ? "whitespace-pre-wrap [overflow-wrap:anywhere]" : "overflow-x-auto",
    "font-mono text-mock-fg [scrollbar-color:var(--color-mock-border)_transparent] [scrollbar-width:thin]",
    className,
  ]}
  tabindex={wrap ? undefined : 0}
  aria-label={label}
  translate="no"><code class:list={["block", !wrap && "min-w-max"]} style={height && `height: ${height}lh; overflow-y: clip`}>{segments.map((seg) => <span class={seg.class} style={seg.style} aria-hidden={seg.hidden}>{seg.rows.map((row) => <span class:list={["flex", row.marked && "bg-mock-accent/12"]}>{numbers && <span class:list={["w-10 shrink-0 pr-4 text-right select-none", row.gutter === "+" ? "text-mock-string" : "text-mock-comment"]} aria-hidden="true">{row.gutter}</span>}<span class="min-w-0 pr-4">{row.tokens.map((t) => t.kind ? <span class={color[t.kind]}>{t.text}</span> : t.text)}{row.tokens.length === 0 && " "}</span></span>)}</span>)}</code></pre>
