{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock load && cf dev",
    "build": "cf build",
    "deploy": "cf deploy --prebuilt",
    "deploy:dry-run": "cf deploy --prebuilt --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply 094e93eb-7015-487f-8888-7d5013a4a8e5 --dir drizzle --pattern 'drizzle/*/migration.sql'",
    "db:push": "drizzle-kit push",
    "test": "vp test --coverage"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@polar-sh/better-auth": "catalog:",
    "@polar-sh/sdk": "^1.0.2",
    "@react-email/components": "^1.0.12",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.7",
    "posthog-node": "^5.55.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.0.3",
    "cf": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "catalog:",
    "varlock": "^1.22.0",
    "vite": "catalog:"
  }
}
